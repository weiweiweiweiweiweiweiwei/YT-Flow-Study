{
  "manifest_version": 3,
  "name": "FlowStudy",
  "version": "1.1",
  "description": "在 YouTube 字幕上點字或選取片語，即時顯示翻譯並自動儲存",
  "permissions": ["storage", "activeTab", "tabs", "alarms", "downloads", "downloads.ui", "offscreen", "identity"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*",
    "https://algdqnztwyrcxuxqnzyp.supabase.co/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["yt-player-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["core/normalize.js", "sentence-timeline.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlowStudy",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  }
}
